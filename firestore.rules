rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Колекція фотографій на карті
    match /photos/{photoId} {
      // Публічне читання для всіх відвідувачів
      allow read: if true;
      
      // Створення дозволено лише автентифікованим користувачам (включаючи Anonymous Auth)
      // з суворою валідацією полів та структури документу
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.emoji is string
        && request.resource.data.emoji.size() <= 10
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.geohash is string
        && request.resource.data.geohash.size() <= 12
        && request.resource.data.mainUrl is string
        && request.resource.data.thumbUrl is string
        && request.resource.data.createdAt != null;
        
      // Оновлення або видалення — тільки автором фото
      allow update, delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
    }
    
    // Заборона запису у всі інші невідомі колекції
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
